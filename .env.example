# ─── Cloudinary Image Upload (REQUIRED for project/certificate photos) ───
# 1. Open https://console.cloudinary.com/settings/api-keys
# 2. Copy "Cloud name" (lowercase, e.g. dxyz12abc — NOT "Portfolio")
# 3. Settings → Upload → Upload presets → Add → Signing Mode: Unsigned
#    Name it: portfolio_unsigned → Save

# Client-side direct upload (used in browser — prefix VITE_)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=portfolio_unsigned

# Server-side fallback (local dev /api/upload — no VITE_ prefix)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Contact form (optional)
VITE_WEB3FORMS_ACCESS_KEY=
CONTACT_TO_EMAIL=roshankumarsingh021@gmail.com
WEB3FORMS_ACCESS_KEY=
