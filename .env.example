# Cloudinary — from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Contact form — client-side (prefix VITE_ for browser access)
# Optional: https://web3forms.com — recommended, free & reliable
VITE_WEB3FORMS_ACCESS_KEY=

# Server-side fallback for /api/contact (Vercel only)
CONTACT_TO_EMAIL=roshankumarsingh021@gmail.com
WEB3FORMS_ACCESS_KEY=
